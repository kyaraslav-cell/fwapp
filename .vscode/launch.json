{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Fishlog: run server",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": ["app.web.app:app", "--reload", "--port", "8000"],
      "cwd": "${workspaceFolder}",
      "justMyCode": true
    },
    {
      "name": "Fishlog: pytest (current file)",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": ["${file}", "-v"],
      "cwd": "${workspaceFolder}",
      "justMyCode": true
    }
  ]
}
