# Copy to `.env` in this directory and fill in what you actually have.
# `.env` is gitignored. Never commit a real key - a key in git history is a
# leaked key even after it is deleted, and it has to be revoked, not removed.
#
# Everything here is optional. Missing means the feature is off, and off is a
# state the app reports honestly rather than a crash.

# The Gemini local-knowledge pass (docs/13 §10). Get a key at
# https://aistudio.google.com/apikey - the free tier is enough: this app makes
# one call per water added, plus one per monthly refresh.
# With no key the `intel` job succeeds and reports "skipped".
FISHLOG_GEMINI_API_KEY=

# Only if the default model id has gone stale. Leave empty otherwise.
FISHLOG_GEMINI_MODEL=

# Sign in with Google (docs/adr/0004). All three, or none - the button is not
# rendered unless all three are set. The redirect URI must also be registered
# in the Google console, exactly as written here.
FISHLOG_GOOGLE_CLIENT_ID=
FISHLOG_GOOGLE_CLIENT_SECRET=
FISHLOG_GOOGLE_REDIRECT_URI=

# Set to 1 ONLY when a reverse proxy in front of this app sets
# X-Forwarded-For (Caddy, a Tailscale funnel). Left unset behind a proxy, every
# request counts as one address and the per-IP rate limit locks everybody out
# together; set to 1 with no proxy, anyone can forge a fresh address per
# attempt and the per-IP limit does nothing.
FISHLOG_TRUST_PROXY=

# Lets a dev container's preview pane frame the app. A preview pane is an
# iframe, and `frame-ancestors 'none'` refuses it - the pane then shows
# "refused to connect", which reads exactly like a dead server and is not.
#
# In a Codespace set it to the editor origin:
#   FISHLOG_FRAME_ANCESTORS=https://*.app.github.dev
#
# Never on a deployment, and never `*`. Opening the forwarded port in a real
# browser tab needs none of this - this is convenience, not a fix.
FISHLOG_FRAME_ANCESTORS=

# kie.ai, for generating the design's raster assets (docs/17-DESIGN-SYSTEM.md).
# Get a key at https://kie.ai. Build-time only: the app never calls kie.ai at
# runtime, the generated files are committed as static assets, so a missing key
# costs nothing on a deployment and only stops `tools/design_assets.py` from
# regenerating them.
#
# The name is `KIE_AI_API_KEY` rather than `FISHLOG_*` because the scrollcraft
# skill's own `kie.mjs` reads that exact name, and one variable read by both is
# better than two that can disagree.
KIE_AI_API_KEY=
