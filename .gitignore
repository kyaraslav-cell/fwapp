__pycache__/
*.pyc
.venv/
venv/
*.db
*.db-shm
*.db-wal
# Uploaded catch photos, at the repository root only. NOT anchored, this
# pattern matched any directory named `media` at any depth - and silently
# swallowed the whole `app/media/` package, which then failed only in CI on a
# fresh clone. The leading slash is the entire fix.
/media/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.env
dist/
spike-verdict.png

# Design working output: full-page renders, animation frames and the 6MB PNGs
# kie.ai returns. The sheets worth keeping are copied into docs/design/, which
# IS tracked - the owner reads them on GitHub and cannot download files.
tools/design_shots/
tools/asset_out/

# scrollcraft build working output: verification shots, node_modules, the
# 8MB PNGs kie.ai returns, and the fetched Google Fonts CSS. The BRIEF, the
# page source, the generate script and the packed assets ARE tracked, and the
# sheets worth keeping are copied into docs/design/.
scrollcraft/builds/*/lab/
scrollcraft/builds/*/out/
scrollcraft/builds/*/node_modules/
scrollcraft/builds/*/package*.json
scrollcraft/builds/*/gf.css
